# yamllint tuned for this repo. Two distinct groups of relaxations, kept apart
# because they are justified differently.
#
# The GitHub Actions dialect genuinely clashes with the defaults:
#   - document-start: workflows conventionally omit the leading "---".
#   - truthy/check-keys: the mandatory `on:` key is not a boolean, and yamllint
#     reads it as one. Values are still checked, only keys are exempt.
#
# The rest are house style, applied everywhere rather than exempted per file.
# Exempting whole workflow files would also stop yamllint catching the things it
# is actually good at there: bad indentation, duplicate keys, stray tabs.
#   - line-length 120: matches the project's other line-length conventions, and
#     workflows carry long ${{ }} expressions and inline shell.
#   - braces/brackets: `{ name: x, type: y }` on one line is how the CI matrix
#     entries read best; the default forbids the inner spaces that make it
#     legible. Bounded at one space, so it stays a style allowance and not a
#     licence for arbitrary whitespace.
extends: default

rules:
  document-start: disable
  truthy:
    check-keys: false
  line-length:
    max: 120
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
